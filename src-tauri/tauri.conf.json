{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duskry",
  "version": "1.1.0",
  "identifier": "app.duskry.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Duskry",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": [
            "underWindowBackground",
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://api.lemonsqueezy.com https://duskry.app; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwRkZBRjEyQkE4QzlGNkUKUldSdW40eTZFcS8vb0FuTmxNcWl0MjhlZG5KQTloc0pweTYva1VERVIzZGwxY3U5bVV5cHNzbVoK",
      "endpoints": [
        "https://github.com/PatoVW02/duskry-app/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
